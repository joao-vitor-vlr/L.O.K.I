# ============================================================
# L.O.K.I — Configuração de Ambiente
# ============================================================
# Copie este arquivo para .env e preencha os valores desejados.

# ── Provider de LLM ─────────────────────────────────────────
# Opções: "ollama" | "openai" | "anthropic"
LLM_PROVIDER=ollama

# ── Ollama (local) ──────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── OpenAI (nuvem) ──────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o
OPENAI_EMBED_MODEL=text-embedding-3-small

# ── Anthropic (nuvem) ───────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_LLM_MODEL=claude-3-5-sonnet-20241022

# ── Graph RAG ───────────────────────────────────────────────
GRAPH_PERSIST_PATH=./data/knowledge_graph.graphml
GRAPH_VIS_PATH=./data/mapa_loki.html

# ── Splitter ────────────────────────────────────────────────
CHUNK_SIZE=1500
CHUNK_OVERLAP=200

# ── GPU AMD RDNA 3 (ROCm) ──────────────────────────────────
# Estas variáveis são injetadas automaticamente pelo env_setup.py
# Descomente para personalizar:
# OLLAMA_FLASH_ATTENTION=1
# OLLAMA_KEEP_ALIVE=-1
# OLLAMA_NUM_PARALLEL=4
# HSA_OVERRIDE_GFX_VERSION=11.0.0
